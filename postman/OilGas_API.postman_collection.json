    {
      "name": "Core setup",
      "item": [
        {
          "name": "Create Field",
          "request": {
            "method": "POST",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Fahud Field\",\n  \"location\": \"Oman\",\n  \"region\": \"Al Dhahirah\"\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              }
            },
            "url": "{{baseUrl}}/oil-fields"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "pm.test(\"status 201\",()=>pm.response.to.have.status(201));",
                  "if(pm.response.code<300){pm.environment.set(\"fieldId\",pm.response.json().id);}"
                ],
                "type": "text/javascript"
              }
            }
          ]
        },
